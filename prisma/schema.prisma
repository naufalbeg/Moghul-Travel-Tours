generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────

enum UserRole {
  MASTER_ADMIN
  ADMIN
}

// The business sells Umrah and Ziarah as one line of trips.
enum PackageCategory {
  UMRAH_ZIARAH
  GROUP_TOUR
  DOMESTIC
}

// Publication state only — whether visitors can see the package at all.
enum PackageStatus {
  DRAFT
  PUBLISHED
}

// Package-level booking availability, shown on cards and the admin list.
// Independent of PackageStatus: a PUBLISHED package can be ALMOST_FULL.
enum PackageAvailability {
  OPEN
  ALMOST_FULL
  FULL
  COMING_SOON
}

// Seat availability for a single departure date.
enum DepartureAvailability {
  OPEN
  ALMOST_FULL
  FULL
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum AnnouncementStatus {
  ACTIVE
  EXPIRED
}

// ── Models (PKG-MTT-009) ────────────────────────────────────────────

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  name           String
  role           UserRole  @default(ADMIN)
  isActive       Boolean   @default(true) @map("is_active")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  packagesCreated Package[]
  galleryUploads  GalleryImage[]
  testimonials    Testimonial[]
  siteConfigEdits SiteConfig[]
  announcements   Announcement[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Package {
  id             String              @id @default(uuid()) @db.Uuid
  slug           String              @unique
  title          String
  category       PackageCategory
  description    String
  // Short bullet points shown on package cards ("Highlights").
  highlights     String[]            @default([])
  // Checklist shown under "What's included" on the detail page.
  inclusions     String[]            @default([])
  durationDays   Int?                @map("duration_days") @db.SmallInt
  durationNights Int?                @map("duration_nights") @db.SmallInt
  // Free text, e.g. "Twin / triple sharing".
  roomSharing    String?             @map("room_sharing")
  pricePerPax    Decimal             @map("price_per_pax") @db.Decimal(10, 2)
  status         PackageStatus       @default(DRAFT)
  availability   PackageAvailability @default(OPEN)
  createdById    String?             @map("created_by") @db.Uuid
  createdBy      User?               @relation(fields: [createdById], references: [id])
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  images     PackageImage[]
  itinerary  PackageItineraryDay[]
  departures PackageDeparture[]

  @@index([status, category])
  @@map("packages")
}

// One itinerary entry. dayEnd is set when an entry spans several days
// ("Day 2–4"), otherwise null ("Day 1").
model PackageItineraryDay {
  id          String  @id @default(uuid()) @db.Uuid
  packageId   String  @map("package_id") @db.Uuid
  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  dayStart    Int     @map("day_start") @db.SmallInt
  dayEnd      Int?    @map("day_end") @db.SmallInt
  title       String
  description String
  sortOrder   Int     @default(0) @map("sort_order")

  @@index([packageId])
  @@map("package_itinerary_days")
}

model PackageDeparture {
  id            String                @id @default(uuid()) @db.Uuid
  packageId     String                @map("package_id") @db.Uuid
  package       Package               @relation(fields: [packageId], references: [id], onDelete: Cascade)
  departureDate DateTime              @map("departure_date") @db.Date
  availability  DepartureAvailability @default(OPEN)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz

  @@unique([packageId, departureDate])
  @@map("package_departures")
}

model PackageImage {
  id          String   @id @default(uuid()) @db.Uuid
  packageId   String   @map("package_id") @db.Uuid
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  storagePath String   @map("storage_path")
  url         String
  isPrimary   Boolean  @default(false) @map("is_primary")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([packageId])
  @@map("package_images")
}

model Inquiry {
  id              String        @id @default(uuid()) @db.Uuid
  fullName        String        @map("full_name")
  phone           String
  email           String
  packageInterest String?       @map("package_interest")
  message         String
  status          InquiryStatus @default(NEW)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@map("inquiries")
}

model GalleryImage {
  id           String   @id @default(uuid()) @db.Uuid
  storagePath  String   @map("storage_path")
  url          String
  tag          String
  uploadedById String?  @map("uploaded_by") @db.Uuid
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("gallery_images")
}

model Testimonial {
  id           String    @id @default(uuid()) @db.Uuid
  customerName String    @map("customer_name")
  tripName     String    @map("trip_name")
  reviewText   String    @map("review_text")
  starRating   Int       @map("star_rating") @db.SmallInt
  tripDate     DateTime? @map("trip_date") @db.Date
  createdById  String?   @map("created_by") @db.Uuid
  createdBy    User?     @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("testimonials")
}

model SiteConfig {
  key         String   @id
  value       String
  updatedById String?  @map("updated_by") @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("site_config")
}

model Announcement {
  id          String             @id @default(uuid()) @db.Uuid
  title       String
  body        String
  status      AnnouncementStatus @default(ACTIVE)
  expiresAt   DateTime?          @map("expires_at") @db.Timestamptz
  createdById String?            @map("created_by") @db.Uuid
  createdBy   User?              @relation(fields: [createdById], references: [id])
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz

  @@map("announcements")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  target    String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_log")
}
